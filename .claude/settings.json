{
  "enabledMcpjsonServers": ["supabase"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-destructive-git.sh\"",
            "statusMessage": "Checking for uncommitted work…",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm tsc --noEmit",
            "statusMessage": "Type-checking (tsc --noEmit)…",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
