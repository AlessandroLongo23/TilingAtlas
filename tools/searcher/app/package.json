{
	"name": "tilesearch",
	"productName": "The Tiling Searcher",
	"version": "0.3.1",
	"private": true,
	"description": "Runs Marek Čtrnáct's tiling engine on a board file",
	"main": "dist/main.cjs",
	"scripts": {
		"build": "node build.mjs",
		"start": "node build.mjs && electron .",
		"dist": "node build.mjs && electron-builder"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.2.2",
		"electron": "^45.0.0",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.28.2",
		"geist": "^1.8.2",
		"vite": "^8.3.5"
	},
	"build": {
		"appId": "atlas.tiling.tilesearch",
		"productName": "The Tiling Searcher",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**",
			"package.json"
		],
		"mac": {
			"target": [
				"dir",
				"zip"
			],
			"category": "public.app-category.education",
			"artifactName": "TheTilingSearcher-mac-arm64.${ext}",
			"identity": "-",
			"extraResources": [
				{
					"from": "../tilesearch",
					"to": "tilesearch"
				},
				{
					"from": "../tileestimate",
					"to": "tileestimate"
				}
			],
			"hardenedRuntime": false
		},
		"win": {
			"artifactName": "TheTilingSearcher-windows-x64.${ext}",
			"target": [
				{ "target": "nsis", "arch": ["x64"] },
				{ "target": "zip", "arch": ["x64"] }
			],
			"extraResources": [
				{
					"from": "../tilesearch.exe",
					"to": "tilesearch.exe"
				},
				{
					"from": "../tileestimate.exe",
					"to": "tileestimate.exe"
				}
			]
		},
		"nsis": {
			"artifactName": "TheTilingSearcher-windows-x64-setup.${ext}",
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
