native-engine/bench
native-engine/bench-fast
native-engine/bench-tf
native-engine/difftest
native-engine/fill-server
native-engine/*.o
native-engine/difftrace.txt

# throwaway patch-growth galleries (the generating scripts are marked THROWAWAY)
tmp-patches/
tmp-star-patches/
tmp-mixed-star-patches/

# scratch / intermediate data (underscore prefix — regenerable, not source-of-truth)
experiments/results/_*
figures/data/_*-tmp.json

# raw figure-trace probe output (regenerable via the FIG_NS probe); the curated per-example
# slice under figures/traces/<name>/ is committed as the figures' data source
figures/traces/_probe/

# ctrnact-oracle compiled binaries (per-palette; regenerable via `make PALETTE=<name>`). Sources kept.
tools/ctrnact-oracle/eu_solver
tools/ctrnact-oracle/eu_pruner
tools/ctrnact-oracle/eu_develop
tools/ctrnact-oracle/eu_solver.*
tools/ctrnact-oracle/eu_pruner.*
tools/ctrnact-oracle/eu_develop.*
tools/ctrnact-oracle/eu_solver_rt
!tools/ctrnact-oracle/eu_*.cpp

# Local research vault + private tooling — local-only on every branch, never committed.
marek-vault/
scripts/import-marek-chat.mjs
scripts/fetch-discord-dm.mjs

# ctrnact-oracle solver output — regenerable from the palettes + `make PALETTE=…`, and hundreds of MB.
# NOTE: this rule was added after 16 palettes had already been committed (regular, star*, composite-*,
# isotoxal-*, girih, spherical, tetromino, …), and gitignore does not apply to tracked files — those
# 16 stay tracked and keep showing up in `git status` when regenerated. The rule binds NEW palettes
# only. Untracking the old ones is a deliberate call, not something to do by accident.
# Staging a regenerated tracked palette needs `git add -u tools/ctrnact-oracle/tables/<name>/` — plain
# `git add` refuses any pathspec under an ignored directory, tracked file or not.
tools/ctrnact-oracle/tables/
tools/ctrnact-oracle/scratch-*/
# per-run worker scratch (`run-<palette>-k<N>b<M>/w0…w7`, `probe-<palette>/`) — written by
# run-oracle.sh / run-ring-sweep.sh, regenerable, and empty once a run is reaped.
tools/ctrnact-oracle/run-*/
!tools/ctrnact-oracle/run-*.sh
tools/ctrnact-oracle/probe-*/
tools/ctrnact-oracle/*.err

# depth-2 sharding measurement runs from the 2026-08 sweep: `rd-k<N>-*` (regular-doubled),
# `rs123-k<N>-*` (regular-scaled-123), `ctl-<palette>/` (single-worker controls). Worker scratch plus
# the raw/pruned cells of each variant, 2.3 GB, and no script reads them. Regenerable via
# `PALETTE=<name> ./run-oracle-parallel.sh <k>`; the measurements that mattered are the tables in
# docs/ctrnact-solver-optimizations.md and the logs in experiments/results/.
tools/ctrnact-oracle/rd-k*/
tools/ctrnact-oracle/rs123-*/
tools/ctrnact-oracle/ctl-*/

# `make check-star` intermediates — the target itself `rm -rf`s and recreates both on every run, so
# they are pure scratch. What the gate compares against is committed: golden/star-ico-d-k{1,2}.txt and
# golden/star-shelf.sha256.
tools/ctrnact-oracle/check-star-run*/
tools/ctrnact-oracle/check-star-buckets/
# `make check-deltahedra` scratch. What the gate compares against is a theorem, held in
# check_deltahedra.py (tracked), so there is no golden file to keep here either.
tools/ctrnact-oracle/check-delta/
# gen_johnson_euclid.py --emit-ts writes this for hand-splicing into lib/render/johnsonSolids.ts.
tools/ctrnact-oracle/johnson-euclid.ts.part
tools/ctrnact-oracle/sph-k2-*/
# k=3 spherical develop output (tools/ctrnact-oracle/run_develop_sharded.py). 137 KB of realized
# geometry that costs 14 minutes on 8 workers to rebuild, and every solid worth keeping out of it is
# spliced into a tracked file — the convex ones into lib/render/johnsonSolids.ts, the reflex ones into
# lib/render/nonconvexSolids.ts. Ignored for the same reason sph-k2-*/ is.
tools/ctrnact-oracle/sph-k3/
tools/ctrnact-oracle/sph-k4/
tools/ctrnact-oracle/sph-k5/
tools/ctrnact-oracle/star-ico-k3/
# Harvest intermediates: gen_johnson_deep.py and gen_nonconvex_shelf.py write these on the way to the
# tracked TS tables and the atlas rows. Regenerable from the cell files above, and the shelf they feed
# IS tracked — lib/render/{johnsonSolids,nonconvexSolids}.ts and public/reference-atlas-spherical.json.
tools/ctrnact-oracle/johnson-deep.ts.part
tools/ctrnact-oracle/johnson-deep-rows.json
tools/ctrnact-oracle/nonconvex-rows.json

# star-shelf build intermediates — all regenerable by tools/ctrnact-oracle/build-star-shelf.sh.
# The rho buckets are derived from the palette (rho_buckets.py), the pyramid cells from a closed form
# (gen_star_pyramids.py), and the index JSON is spliced into lib/tilings/sph-star.ts, which IS tracked.
tools/ctrnact-oracle/buckets-*.json
tools/ctrnact-oracle/pyramid-cells.json
tools/ctrnact-oracle/star-shelf-index.json

# generated landing hero assets (scripts/gen-landing-data.ts; regenerated by pnpm build)
public/hero-index.json
public/hero-cells/

# local corpora drops from Marek/Craig/Joseph — gigabytes, and the shipped artefacts are what get committed
materials/

# any other Next dist dir: `NEXT_DIST_DIR=.next-prod pnpm build` keeps a prod build from clobbering the
# running dev server's `.next` (see next.config.ts), `.next-studio` is the same for a second dev server,
# and a stale cache moved aside lands here too. Each holds thousands of files.
.next-*/

# one-off driver scripts (Playwright probes, throwaway harnesses). Never part of a build.
scripts/tmp/

# develop benchmark block sets and their outputs — copies of pruned files, rebuilt by bench/setup.sh.
# The harness itself (bench/*.sh, bench/*.py) IS tracked; its inputs are search output, not source.
tools/ctrnact-oracle/bench/tiny/
tools/ctrnact-oracle/bench/one/
tools/ctrnact-oracle/bench/hot/
tools/ctrnact-oracle/bench/fast/
tools/ctrnact-oracle/bench/big/
tools/ctrnact-oracle/bench/real/
tools/ctrnact-oracle/bench/*.json
tools/ctrnact-oracle/bench/*.json.shards/
tools/ctrnact-oracle/bench/*-report.txt
tools/ctrnact-oracle/bench/*-driver.log
tools/ctrnact-oracle/bench/*.log
